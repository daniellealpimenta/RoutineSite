# Copie para .env e preencha. O .env não vai para o git.
# Chave gratuita em https://build.nvidia.com (botão "Get API Key")
NVIDIA_API_KEY=nvapi-sua-chave-aqui
# Opcionais
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# PORT=8000
# HOST=0.0.0.0   # para abrir no celular pela rede local (cuidado: qualquer um na rede usa sua chave)
# Cotas do servidor local (mesmas regras do Worker; veja wrangler.toml)
# LIMITE_POR_MINUTO=6
# LIMITE_POR_DIA=60
# LIMITE_GLOBAL_DIA=600
# LIMITE_SIMULTANEOS=2
